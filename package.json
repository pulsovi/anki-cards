{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "husky": "^7.0.0",
    "lint-staged": "^11.2.5"
  },
  "scripts": {
    "commit-msg": "yarn npm-run-all \"commit-msg:\\* -- $@\"",
    "commit-msg:anki-pug": "cd packages/anki-pug && yarn commit-msg",
    "postinstall": "husky install",
    "pre-commit": "yarn npm-run-all pre-commit:\\*",
    "pre-commit:_": "lint-staged",
    "pre-commit:anki-connect": "cd packages/anki-connect && yarn pre-commit",
    "pre-commit:anki-pug": "cd packages/anki-pug && yarn pre-commit"
  },
  "resolutions": {
    "task-syncer": "portal:../../task-syncer",
    "ini": "~1.3.6"
  },
  "packageManager": "yarn@3.2.1",
  "engines": {
    "node": ">=8.5.0"
  },
  "dependencies": {
    "eslint": "^8.8.0",
    "lodash": "^4.17.21",
    "npm-run-all": "^3.1.1"
  }
}
