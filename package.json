{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "eslint_d": "^12.2.1",
    "husky": "^7.0.0",
    "lint-staged": "^13.2.2"
  },
  "scripts": {
    "commit-msg": "npm-run-all \"commit-msg:\\* -- $@\"",
    "commit-msg:anki-pug": "cd packages/anki-pug && yarn commit-msg",
    "postinstall": "yarn husky install",
    "pre-commit": "lint-staged"
  },
  "resolutions": {
    "task-syncer": "portal:../../task-syncer",
    "ini": "~1.3.6"
  },
  "packageManager": "yarn@3.2.1",
  "engines": {
    "node": ">=8.5.0"
  },
  "dependencies": {
    "eslint": "^8.8.0",
    "lodash": "^4.17.21",
    "npm-run-all": "^3.1.1"
  }
}
