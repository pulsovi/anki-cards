{
  "name": "anki-connect",
  "version": "0.1.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "types"
  ],
  "types": "types",
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "core-js": "^3.22.8",
    "task-syncer": "^0.1.0"
  },
  "scripts": {
    "build": "rm -rf ./dist && yarn babel src --out-dir ./dist --extensions \".ts\" $*",
    "emit-types": "tsc --declaration --emitDeclarationOnly",
    "lint": "yarn eslint .",
    "pre-commit": "yarn lint-staged",
    "prepack": "yarn build && yarn emit-types"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.18.2",
    "@typescript-eslint/parser": "^5.27.1",
    "eslint": "^8.17.0",
    "eslint-config-pulsovi-typescript": "^0.3.8",
    "lint-staged": "^13.0.2",
    "typescript": "^4.7.3"
  },
  "packageManager": "yarn@3.2.1"
}
